      "id": "032",
      "image_id": "032",
      "start": 93.2333,
      "end": 96.8667,
      "voice_text": "1895 में एक किताब संरक्षक को",
      "motion": "STATIC",
      "transition": "CROSSFADE",
      "transition_config": {
        "type": "CROSSFADE",
        "frames": 13
      }
    },
    {
      "id": "033",
      "image_id": "033",
      "start": 96.8667,
      "end": 100.6667,
      "voice_text": "एक पुरानी याददाश्त के footnote में इसका जिक्र मिला",
