  "captions": [
    {
      "id": "001",
      "start": 0.22,
      "end": 1.24,
      "text": "चीन की दीवार के",
      "word_start_index": 1,
      "word_end_index": 4
    },
    {
      "id": "002",
      "start": 1.26,
      "end": 2.42,
      "text": "बारे में सबने सुना",
      "word_start_index": 5,
      "word_end_index": 8
    },
    {
      "id": "003",
      "start": 2.48,
      "end": 4.32,
      "text": "है। लेकिन अंग्रेजों ने",
      "word_start_index": 9,
      "word_end_index": 12
    },
    {
      "id": "004",
      "start": 4.36,
      "end": 5.78,
      "text": "भारत के बीचों-बीच भी",
      "word_start_index": 13,
      "word_end_index": 16
    },
    {
      "id": "005",
      "start": 6.3,
      "end": 7.54,
      "text": "एक दीवार उगाई थी,",
      "word_start_index": 17,
      "word_end_index": 20
    },
    {
      "id": "006",
      "start": 8.119,
      "end": 9.84,
      "text": "कांटों की दीवार और",
      "word_start_index": 21,
      "word_end_index": 24
    },
    {
      "id": "007",
      "start": 9.88,
      "end": 11.08,
      "text": "वो किसी दुश्मन फ़ौज",
      "word_start_index": 25,
      "word_end_index": 28
    },
    {
      "id": "008",
      "start": 11.12,
      "end": 11.64,
      "text": "के लिए नहीं,",
      "word_start_index": 29,
      "word_end_index": 31
    },
    {
      "id": "009",
      "start": 12.18,
      "end": 13.54,
      "text": "सिर्फ़ नमक के लिए",
      "word_start_index": 32,
      "word_end_index": 35
    },
    {
      "id": "010",
      "start": 13.58,
      "end": 15.06,
      "text": "थी। उस दौर में",
      "word_start_index": 36,
      "word_end_index": 39
    },
    {
      "id": "011",
      "start": 15.12,
      "end": 16.32,
      "text": "नमक पर भारी tax",
      "word_start_index": 40,
      "word_end_index": 43
    },
    {
      "id": "012",
      "start": 16.36,
      "end": 17.9,
      "text": "लगता था और जहां",
      "word_start_index": 44,
      "word_end_index": 47
    },
    {
      "id": "013",
      "start": 17.96,
      "end": 19.04,
      "text": "नमक कम मिलता था,",
      "word_start_index": 48,
      "word_end_index": 51
    },
    {
      "id": "014",
      "start": 19.54,
      "end": 20.38,
      "text": "वहां के लोगों पर",
      "word_start_index": 52,
      "word_end_index": 55
    },
    {
      "id": "015",
      "start": 20.46,
      "end": 22.1,
      "text": "यह tax सबसे ज्यादा",
      "word_start_index": 56,
      "word_end_index": 59
    },
    {
      "id": "016",
      "start": 22.14,
      "end": 23.9,
      "text": "पड़ता था। तस्कर इस",
      "word_start_index": 60,
      "word_end_index": 63
    },
    {
      "id": "017",
      "start": 23.94,
      "end": 25.62,
      "text": "tax से बचकर नमक",
      "word_start_index": 64,
      "word_end_index": 67
    },
    {
      "id": "018",
      "start": 25.74,
      "end": 26.66,
      "text": "इधर से उधर ले",
      "word_start_index": 68,
      "word_end_index": 71
    },
    {
      "id": "019",
      "start": 26.74,
      "end": 29.34,
      "text": "जाते थे। इसलिए अंग्रेजों",
      "word_start_index": 72,
      "word_end_index": 75
    },
    {
      "id": "020",
      "start": 29.38,
      "end": 30.58,
      "text": "ने पंजाब से मध्य",
      "word_start_index": 76,
      "word_end_index": 79
    },
    {
      "id": "021",
      "start": 30.7,
      "end": 32.78,
      "text": "भारत तक 2000 मील",
      "word_start_index": 80,
      "word_end_index": 83
    },
    {
      "id": "022",
      "start": 32.88,
      "end": 34.28,
      "text": "से भी लंबी एक",
      "word_start_index": 84,
      "word_end_index": 87
    },
    {
      "id": "023",
      "start": 34.32,
      "end": 36.2,
      "text": "customs line बना दी।",
      "word_start_index": 88,
      "word_end_index": 91
    },
    {
      "id": "024",
      "start": 36.24,
      "end": 38.04,
      "text": "फिर 1840 के दशक",
      "word_start_index": 92,
      "word_end_index": 95
    },
    {
      "id": "025",
      "start": 38.12,
      "end": 39.44,
      "text": "में इस line को",
      "word_start_index": 96,
      "word_end_index": 99
    },
    {
      "id": "026",
      "start": 39.48,
      "end": 41.12,
      "text": "कांटेदार झाड़ियों से मजबूत",
      "word_start_index": 100,
      "word_end_index": 103
    },
    {
      "id": "027",
      "start": 41.16,
      "end": 42.52,
      "text": "किया जाने लगा।",
      "word_start_index": 104,
      "word_end_index": 106
    },
    {
      "id": "028",
      "start": 42.56,
      "end": 44.3,
      "text": "धीरे-धीरे यह जिंदा दीवार",
      "word_start_index": 107,
      "word_end_index": 110
    },
    {
      "id": "029",
      "start": 44.4,
      "end": 45.7,
      "text": "1100 मील से भी",
      "word_start_index": 111,
      "word_end_index": 114
    },
    {
      "id": "030",
      "start": 45.78,
      "end": 47.44,
      "text": "ज्यादा लंबी हो गई।",
      "word_start_index": 115,
      "word_end_index": 118
    },
    {
      "id": "031",
      "start": 47.5,
      "end": 48.82,
      "text": "यानी बर्लिन से मॉस्को",
      "word_start_index": 119,
      "word_end_index": 122
    },
    {
      "id": "032",
      "start": 48.86,
      "end": 49.88,
      "text": "तक की दूरी जितनी",
      "word_start_index": 123,
      "word_end_index": 126
    },
    {
      "id": "033",
      "start": 50.48,
      "end": 51.5,
      "text": "और इसकी निगरानी में",
      "word_start_index": 127,
      "word_end_index": 130
    },
    {
      "id": "034",
      "start": 51.58,
      "end": 52.98,
      "text": "लगभग 12 हज़ार लोग",
      "word_start_index": 131,
      "word_end_index": 134
    },
    {
      "id": "035",
      "start": 53.02,
      "end": 54.42,
      "text": "लगे रहते थे।",
      "word_start_index": 135,
      "word_end_index": 137
    },
    {
      "id": "036",
      "start": 54.46,
      "end": 55.5,
      "text": "फिर भी तस्कर रुके",
      "word_start_index": 138,
      "word_end_index": 141
    },
    {
      "id": "037",
      "start": 55.54,
      "end": 57.34,
      "text": "नहीं। कोई ऊंटों और",
      "word_start_index": 142,
      "word_end_index": 145
    },
    {
      "id": "038",
      "start": 57.38,
      "end": 59.1,
      "text": "मवेशियों के साथ जबरदस्ती",
      "word_start_index": 146,
      "word_end_index": 149
    },
    {
      "id": "039",
      "start": 59.16,
      "end": 60.62,
      "text": "घुस जाता तो कोई",
      "word_start_index": 150,
      "word_end_index": 153
    },
    {
      "id": "040",
      "start": 60.66,
      "end": 61.94,
      "text": "नमक की बोरियां दीवार",
      "word_start_index": 154,
      "word_end_index": 157
    },
    {
      "id": "041",
      "start": 62.04,
      "end": 62.96,
      "text": "के ऊपर से फेंक",
      "word_start_index": 158,
      "word_end_index": 161
    },
    {
      "id": "042",
      "start": 63,
      "end": 66.68,
      "text": "देता। आखिरकार 1879 में",
      "word_start_index": 162,
      "word_end_index": 165
    },
    {
      "id": "043",
      "start": 66.72,
      "end": 68.12,
      "text": "यह customs line खत्म",
      "word_start_index": 166,
      "word_end_index": 169
    },
    {
      "id": "044",
      "start": 68.22,
      "end": 69.5,
      "text": "कर दी गई।",
      "word_start_index": 170,
      "word_end_index": 172
    },
    {
      "id": "045",
      "start": 69.56,
      "end": 70.74,
      "text": "लेकिन नमक पर tax",
      "word_start_index": 173,
      "word_end_index": 176
    },
    {
      "id": "046",
      "start": 70.78,
      "end": 72.52,
      "text": "नहीं हटा। बस उसे",
      "word_start_index": 177,
      "word_end_index": 180
    },
    {
      "id": "047",
      "start": 72.58,
      "end": 73.9,
      "text": "वसूलने का तरीका बदल",
      "word_start_index": 181,
      "word_end_index": 184
    },
    {
      "id": "048",
      "start": 73.98,
      "end": 75.6,
      "text": "गया और जब line",
      "word_start_index": 185,
      "word_end_index": 188
    },
    {
      "id": "049",
      "start": 75.64,
      "end": 77.28,
      "text": "हटी तो दो दशक",
      "word_start_index": 189,
      "word_end_index": 192
    },
    {
      "id": "050",
      "start": 77.3,
      "end": 78.36,
      "text": "में नमक की खपत",
      "word_start_index": 193,
      "word_end_index": 196
    },
    {
      "id": "051",
      "start": 78.38,
      "end": 80.48,
      "text": "50% बढ़ गई।",
      "word_start_index": 197,
      "word_end_index": 199
    },
    {
      "id": "052",
      "start": 80.54,
      "end": 81.88,
      "text": "यानी लाखों लोग बरसों",
      "word_start_index": 200,
      "word_end_index": 203
    },
    {
      "id": "053",
      "start": 81.9,
      "end": 82.98,
      "text": "तक जरूरत से कम",
      "word_start_index": 204,
      "word_end_index": 207
    },
    {
      "id": "054",
      "start": 83.02,
      "end": 84.24,
      "text": "नमक खा रहे थे।",
      "word_start_index": 208,
      "word_end_index": 211
    },
    {
      "id": "055",
      "start": 84.3,
      "end": 85.52,
      "text": "इसी tax के खिलाफ",
      "word_start_index": 212,
      "word_end_index": 215
    },
    {
      "id": "056",
      "start": 85.98,
      "end": 88.46,
      "text": "1930 में गांधीजी ने",
      "word_start_index": 216,
      "word_end_index": 219
    },
    {
      "id": "057",
      "start": 88.5,
      "end": 90.28,
      "text": "दांडी की राह पकड़ी।",
      "word_start_index": 220,
      "word_end_index": 223
    },
    {
      "id": "058",
      "start": 90.36,
      "end": 91.42,
      "text": "आज उस दीवार का",
      "word_start_index": 224,
      "word_end_index": 227
    },
    {
      "id": "059",
      "start": 91.46,
      "end": 93.24,
      "text": "कोई निशान नहीं बचा।",
      "word_start_index": 228,
      "word_end_index": 231
    },
    {
      "id": "060",
      "start": 93.26,
      "end": 95.74,
      "text": "1895 में एक किताब",
      "word_start_index": 232,
      "word_end_index": 235
    },
    {
      "id": "061",
      "start": 95.84,
      "end": 97.54,
      "text": "संरक्षक को एक पुरानी",
      "word_start_index": 236,
      "word_end_index": 239
    },
    {
      "id": "062",
      "start": 97.66,
      "end": 99.32,
      "text": "याददाश्त के footnote में",
      "word_start_index": 240,
      "word_end_index": 243
    },
    {
      "id": "063",
      "start": 99.38,
      "end": 100.9,
      "text": "इसका जिक्र मिला और",
      "word_start_index": 244,
      "word_end_index": 247
    },
    {
      "id": "064",
      "start": 100.94,
      "end": 102.08,
      "text": "तब जाकर यह भूली",
      "word_start_index": 248,
      "word_end_index": 251
    },
    {
      "id": "065",
      "start": 102.1,
      "end": 104.18,
      "text": "हुई दीवार दोबारा सामने आई।",
      "word_start_index": 252,
      "word_end_index": 256
    }
  ],
