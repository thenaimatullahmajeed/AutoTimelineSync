  "scenes": [
    {
      "id": "001",
      "image_id": "001",
      "start": 0.0,
      "end": 3.2667,
      "voice_text": "चीन की दीवार के बारे में सबने सुना है।",
      "motion": "SLOW_PUSH_IN",
      "transition": "HARD_CUT"
    },
    {
      "id": "002",
      "image_id": "002",
      "start": 3.2667,
      "end": 6.2,
      "voice_text": "लेकिन अंग्रेजों ने भारत के बीचों-बीच भी",
      "motion": "PAN_RIGHT",
      "transition": "DISSOLVE_BLUR",
      "transition_config": {
        "type": "DISSOLVE_BLUR",
        "frames": 13
      }
    },
    {
      "id": "003",
      "image_id": "003",
      "start": 6.2,
      "end": 9.6333,
      "voice_text": "एक दीवार उगाई थी, कांटों की दीवार",
      "motion": "STATIC",
      "transition": "HARD_CUT"
    },
    {
      "id": "004",
      "image_id": "004",
      "start": 9.6333,
      "end": 12.0667,
      "voice_text": "और वो किसी दुश्मन फ़ौज के लिए नहीं,",
      "motion": "SLOW_ZOOM_OUT",
      "transition": "GENTLE_DISSOLVE",
      "transition_config": {
        "type": "GENTLE_DISSOLVE",
        "frames": 13
      }
    },
    {
      "id": "005",
      "image_id": "005",
      "start": 12.0667,
      "end": 14.4333,
      "voice_text": "सिर्फ़ नमक के लिए थी।",
      "motion": "SLOW_PUSH_IN",
      "transition": "FILM_FLASH",
      "transition_config": {
        "type": "FILM_FLASH",
        "frames": 7
      },
      "sfx": [
        {
          "id": "IMPACT_SOFT",
          "offset_ms": 0,
          "gain_db": -22
        }
      ]
    },
    {
      "id": "006",
      "image_id": "006",
      "start": 14.4333,
      "end": 17.3667,
      "voice_text": "उस दौर में नमक पर भारी tax लगता था",
      "motion": "STATIC",
      "transition": "CROSSFADE",
      "transition_config": {
        "type": "CROSSFADE",
        "frames": 13
      }
    },
    {
      "id": "007",
      "image_id": "007",
      "start": 17.3667,
      "end": 19.4333,
      "voice_text": "और जहां नमक कम मिलता था,",
      "motion": "SLOW_PUSH_IN",
      "transition": "DISSOLVE",
      "transition_config": {
        "type": "DISSOLVE",
        "frames": 13
      }
    },
    {
      "id": "008",
      "image_id": "008",
      "start": 19.4333,
      "end": 23.1333,
      "voice_text": "वहां के लोगों पर यह tax सबसे ज्यादा पड़ता था।",
      "motion": "SLOW_ZOOM_OUT",
      "transition": "HARD_CUT"
    },
    {
      "id": "009",
      "image_id": "009",
      "start": 23.1333,
      "end": 25.2333,
      "voice_text": "तस्कर इस tax से बचकर",
      "motion": "STATIC",
      "transition": "HARD_CUT"
    },
    {
      "id": "010",
      "image_id": "010",
      "start": 25.2333,
      "end": 28.0,
      "voice_text": "नमक इधर से उधर ले जाते थे।",
      "motion": "PAN_LEFT",
      "transition": "CROSSFADE",
      "transition_config": {
        "type": "CROSSFADE",
        "frames": 13
      }
    },
    {
      "id": "011",
      "image_id": "011",
      "start": 28.0,
      "end": 31.9667,
      "voice_text": "इसलिए अंग्रेजों ने पंजाब से मध्य भारत तक",
      "motion": "SLOW_PUSH_IN",
      "transition": "SLIDE_SHADOW",
      "transition_config": {
        "type": "SLIDE_SHADOW",
        "frames": 13
      },
      "sfx": [
        {
          "id": "PAPER_SLIDE",
          "offset_ms": 0,
          "gain_db": -22
        }
      ]
    },
    {
      "id": "012",
      "image_id": "012",
      "start": 31.9667,
      "end": 36.2333,
      "voice_text": "2000 मील से भी लंबी एक customs line बना दी।",
      "motion": "STATIC",
      "transition": "HARD_CUT"
    },
    {
      "id": "013",
      "image_id": "013",
      "start": 36.2333,
      "end": 38.6667,
      "voice_text": "फिर 1840 के दशक में",
      "motion": "SLOW_PUSH_IN",
      "transition": "FADE_THROUGH_BLACK",
      "transition_config": {
        "type": "FADE_THROUGH_BLACK",
        "frames": 13
      },
      "sfx": [
        {
          "id": "TICK_SOFT",
          "offset_ms": 187,
          "gain_db": -22
        }
      ]
    },
    {
      "id": "014",
      "image_id": "014",
      "start": 38.6667,
      "end": 42.5333,
      "voice_text": "इस line को कांटेदार झाड़ियों से मजबूत किया जाने लगा।",
      "motion": "PAN_RIGHT",
      "transition": "HARD_CUT"
    },
    {
      "id": "015",
      "image_id": "015",
      "start": 42.5333,
      "end": 44.3333,
      "voice_text": "धीरे-धीरे यह जिंदा दीवार",
      "motion": "STATIC",
      "transition": "GENTLE_DISSOLVE",
      "transition_config": {
        "type": "GENTLE_DISSOLVE",
        "frames": 13
      }
    },
    {
      "id": "016",
      "image_id": "016",
      "start": 44.3333,
      "end": 47.4667,
      "voice_text": "1100 मील से भी ज्यादा लंबी हो गई।",
      "motion": "SLOW_ZOOM_OUT",
      "transition": "ZOOM_BLUR",
      "transition_config": {
        "type": "ZOOM_BLUR",
        "frames": 10
      },
      "sfx": [
        {
          "id": "IMPACT_SOFT",
          "offset_ms": 67,
          "gain_db": -22
        }
      ]
    },
    {
      "id": "017",
      "image_id": "017",
      "start": 47.4667,
      "end": 50.3667,
      "voice_text": "यानी बर्लिन से मॉस्को तक की दूरी जितनी",
      "motion": "STATIC",
      "transition": "CROSSFADE",
      "transition_config": {
        "type": "CROSSFADE",
        "frames": 13
      }
    },
    {
      "id": "018",
      "image_id": "018",
      "start": 50.3667,
      "end": 54.4333,
      "voice_text": "और इसकी निगरानी में लगभग 12 हज़ार लोग लगे रहते थे।",
      "motion": "SLOW_PUSH_IN",
      "transition": "HARD_CUT"
    },
    {
      "id": "019",
      "image_id": "019",
      "start": 54.4333,
      "end": 56.4333,
      "voice_text": "फिर भी तस्कर रुके नहीं।",
      "motion": "STATIC",
      "transition": "HARD_CUT"
    },
    {
      "id": "020",
      "image_id": "020",
      "start": 56.4333,
      "end": 60.1667,
      "voice_text": "कोई ऊंटों और मवेशियों के साथ जबरदस्ती घुस जाता",
      "motion": "PAN_LEFT",
      "transition": "WHIP_PAN",
      "transition_config": {
        "type": "WHIP_PAN",
        "frames": 7
      },
      "sfx": [
        {
          "id": "WHOOSH_SOFT",
          "offset_ms": 0,
          "gain_db": -24
        }
      ]
    },
    {
      "id": "021",
      "image_id": "021",
      "start": 60.1667,
      "end": 63.7,
      "voice_text": "तो कोई नमक की बोरियां दीवार के ऊपर से फेंक देता।",
      "motion": "PAN_RIGHT",
      "transition": "HARD_CUT"
    },
    {
      "id": "022",
      "image_id": "022",
      "start": 63.7,
      "end": 67.8,
      "voice_text": "आखिरकार 1879 में यह customs line",
      "motion": "STATIC",
      "transition": "FILM_BURN",
      "transition_config": {
        "type": "FILM_BURN",
        "frames": 13
      },
      "sfx": [
        {
          "id": "STAMP_THUD",
          "offset_ms": 300,
          "gain_db": -22
        }
      ]
    },
    {
      "id": "023",
      "image_id": "023",
      "start": 67.8,
      "end": 69.5333,
      "voice_text": "खत्म कर दी गई।",
      "motion": "SLOW_ZOOM_OUT",
      "transition": "CROSSFADE",
      "transition_config": {
        "type": "CROSSFADE",
        "frames": 13
      }
    },
    {
      "id": "024",
      "image_id": "024",
      "start": 69.5333,
      "end": 72.0333,
      "voice_text": "लेकिन नमक पर tax नहीं हटा।",
      "motion": "SLOW_PUSH_IN",
      "transition": "DISSOLVE",
      "transition_config": {
        "type": "DISSOLVE",
        "frames": 13
      }
    },
    {
      "id": "025",
      "image_id": "025",
      "start": 72.0333,
      "end": 74.8333,
      "voice_text": "बस उसे वसूलने का तरीका बदल गया",
      "motion": "STATIC",
      "transition": "HARD_CUT"
    },
    {
      "id": "026",
      "image_id": "026",
      "start": 74.8333,
      "end": 76.6667,
      "voice_text": "और जब line हटी तो",
      "motion": "PAN_LEFT",
      "transition": "GENTLE_DISSOLVE",
      "transition_config": {
        "type": "GENTLE_DISSOLVE",
        "frames": 13
      }
    },
    {
      "id": "027",
      "image_id": "027",
      "start": 76.6667,
      "end": 80.5,
      "voice_text": "दो दशक में नमक की खपत 50% बढ़ गई।",
      "motion": "STATIC",
      "transition": "CROSSFADE",
      "transition_config": {
        "type": "CROSSFADE",
        "frames": 13
      }
    },
    {
      "id": "028",
      "image_id": "028",
      "start": 80.5,
      "end": 84.2667,
      "voice_text": "यानी लाखों लोग बरसों तक जरूरत से कम नमक खा रहे थे।",
      "motion": "SLOW_ZOOM_OUT",
      "transition": "SMOKE_DISSOLVE",
      "transition_config": {
        "type": "SMOKE_DISSOLVE",
        "frames": 13
      }
    },
    {
      "id": "029",
      "image_id": "029",
      "start": 84.2667,
      "end": 87.6667,
      "voice_text": "इसी tax के खिलाफ 1930 में",
      "motion": "STATIC",
      "transition": "FADE_THROUGH_WHITE",
      "transition_config": {
        "type": "FADE_THROUGH_WHITE",
        "frames": 13
      }
    },
    {
      "id": "030",
      "image_id": "030",
      "start": 87.6667,
      "end": 90.3333,
      "voice_text": "गांधीजी ने दांडी की राह पकड़ी।",
      "motion": "SLOW_PUSH_IN",
      "transition": "HARD_CUT"
    },
    {
      "id": "031",
      "image_id": "031",
      "start": 90.3333,
      "end": 93.2333,
      "voice_text": "आज उस दीवार का कोई निशान नहीं बचा।",
      "motion": "SLOW_ZOOM_OUT",
      "transition": "FADE_THROUGH_BLACK",
      "transition_config": {
        "type": "FADE_THROUGH_BLACK",
        "frames": 13
      }
    },
